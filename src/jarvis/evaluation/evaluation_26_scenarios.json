{
  "benchmark_version": "1.0.0",
  "name": "Prompt 026 Universal Agent Reasoning & Computer Operation Benchmark",
  "total_scenarios": 200,
  "categories": [
    "COMMUNICATION",
    "REASONING",
    "CROSS_APP_WORKFLOW",
    "UNKNOWN_APP_DISCOVERY",
    "SAFETY_CONFIRMATION"
