      "expected_domain": "COMMUNICATION",
      "requires_approval": true
    },
    {
      "id": "COMM_002",
      "query": "Draft an email to Vasanth about the project deadline.",
      "expected_objective": "SEND_EMAIL",
      "expected_recipient": "Vasanth",
      "expected_domain": "COMMUNICATION",
      "requires_approval": true
    },
    {
      "id": "COMM_003",
      "query": "Find contact info for Vasanth.",
      "expected_objective": "SEND_EMAIL",
      "expected_recipient": "Vasanth",
      "expected_domain": "COMMUNICATION",
      "requires_approval": false
    },
    {
      "id": "WORKFLOW_001",
      "query": "Read monthly_report.txt and email summary to Vasanth.",
